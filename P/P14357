#include <bits/stdc++.h>
using namespace std;
const int maxn = 1e6 + 1000;
string s;
int a[maxn];
int main(){
    int ttt = 1;
    cin >> s;
    for(int i = 0;i < s.length();i++){
        if(s[i] >= '0' && s[i] <= '9'){
            a[ttt] = s[i] - '0';
            ttt++;
        }
    }
    sort(a + 1,a + ttt);
    for(int i = ttt - 1;i >= 1;i--){
        printf("%d",a[i]);
    }
}
